# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Pinecone (https://app.pinecone.io) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=multimodal-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBEDDING_DIM=768

# --- Redis (run locally via Docker: redis/redis-stack) ---
REDIS_URL=
REDIS_CACHE_INDEX_NAME=llmcache
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.2

# --- SQLite ---
SQLITE_DB_PATH=data/docstore.db

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50

HF_TOKEN=
